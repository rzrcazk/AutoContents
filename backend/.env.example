PORT=3710
RSSHUB_URL=http://localhost:1200

# 数据库配置（SQLite - 默认）
DB_PATH=./data/app.db

# PostgreSQL 配置（可选，启用时 DB_DRIVER=postgres）
DB_DRIVER=sqlite
PGHOST=localhost
PGPORT=5432
PGDATABASE=autocontents
PGUSER=postgres
PGPASSWORD=your_password

RENDER_OUTPUT_DIR=./uploads/rendered
NODE_ENV=development

# Docker 部署时指定 Chromium 路径（留空则自动探测）
# CHROME_PATH=/usr/bin/chromium
